NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4321
CORS_ORIGINS=http://localhost:4321,https://sabinosmotorcycles2.infosist.org

DATABASE_URL=postgresql://postgres:password@localhost:5432/catalogoMotos
# Alternativa si no utilizas DATABASE_URL:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=catalogoMotos
# PGUSER=postgres
# PGPASSWORD=password
# PGSSLMODE=disable

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
COOKIE_NAME=auth_token
BCRYPT_ROUNDS=8
