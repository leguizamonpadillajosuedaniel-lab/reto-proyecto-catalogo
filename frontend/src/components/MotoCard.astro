---
import type { Moto } from '../types/moto';
import { motoImage } from '../lib/images';
import { modeloSlug, categoriaLabel } from '../lib/modelos';
const { moto } = Astro.props as { moto: Moto };
---
<article class="group overflow-hidden rounded-2xl bg-white shadow-power transition hover:-translate-y-1">
  <div class="relative aspect-[4/3] overflow-hidden bg-gray-100"><img src={motoImage(moto.modelo, moto.imagenLink)} alt={moto.modelo} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /><span class="absolute left-4 top-4 rounded-full bg-power-red px-3 py-1 text-xs font-bold uppercase text-white">{categoriaLabel(moto.categoria)}</span></div>
  <div class="p-5"><div class="flex items-start justify-between gap-3"><div><h3 class="text-2xl">{moto.modelo}</h3><p class="mt-1 text-sm text-gray-500">{moto.cilindrada} cc · {moto.marca}</p></div><span class:list={["text-xs font-bold", moto.stock > 0 ? 'text-green-600' : 'text-power-red']}>{moto.stock > 0 ? 'Disponible' : 'Agotada'}</span></div><p class="mt-4 line-clamp-2 min-h-10 text-sm leading-5 text-gray-600">{moto.descripcion}</p><div class="mt-5 flex items-center justify-between border-t pt-4"><span class="text-lg font-bold text-power-red">Bs {moto.precio.toLocaleString('es-BO')}</span><a href={`/catalogo/${modeloSlug(moto.modelo)}`} class="text-sm font-bold uppercase text-power-ink hover:text-power-red">Ver detalle →</a></div></div>
</article>
