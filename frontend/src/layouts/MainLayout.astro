  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Catálogo de motos Sabino's Motorcycle" /><title>{title}</title></head>
  <body><Header /><main><slot /></main><Footer /></body>
