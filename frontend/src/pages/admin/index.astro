---
import MainLayout from '../../layouts/MainLayout.astro';
---
<MainLayout title="Administración | Power Motorcycle"><section class="bg-power-charcoal py-12 text-white"><div class="container-power flex flex-wrap items-end justify-between gap-5"><div><p class="text-sm font-bold uppercase tracking-widest text-power-orange">Panel privado</p><h1 class="mt-2 text-6xl">Administrar motos</h1><p id="welcome" class="mt-2 text-gray-300"></p></div><button id="logout" class="rounded-full border border-white/30 px-5 py-3 text-sm font-bold uppercase hover:border-power-orange hover:text-power-orange">Cerrar sesión</button></div></section><section class="py-12"><div class="container-power grid gap-8 lg:grid-cols-[.8fr_1.2fr]"><div class="rounded-2xl bg-white p-6 shadow-power"><div class="flex items-center justify-between"><h2 id="form-title" class="text-3xl">Nueva moto</h2><button id="cancel-edit" class="hidden text-sm font-bold text-gray-500">Cancelar</button></div><form id="moto-form" class="mt-6 space-y-4" novalidate><input type="hidden" name="identificador" /><label class="block text-sm font-semibold">Modelo<input name="modelo" class="field-power" /></label><p data-error="modelo" class="error-power"></p><label class="block text-sm font-semibold">Marca<input name="marca" value="Power Motorcycle" readonly class="field-power bg-gray-100" /></label><p data-error="marca" class="error-power"></p><label class="block text-sm font-semibold">Categoría<select name="categoria" class="field-power"><option value="Automaticas">Automaticas</option><option value="Aventura">Aventura</option><option value="Deportiva">Deportiva</option><option value="Scoter">Scoter</option><option value="utilitarias">utilitarias</option></select></label><label class="block text-sm font-semibold">Cilindrada<input name="cilindrada" type="number" min="0" class="field-power" /></label><p data-error="cilindrada" class="error-power"></p><div class="grid gap-4 sm:grid-cols-2"><label class="block text-sm font-semibold">Precio<input name="precio" type="number" min="0" step="0.01" class="field-power" /></label><label class="block text-sm font-semibold">Stock<input name="stock" type="number" min="0" value="0" class="field-power" /></label></div><p data-error="precio" class="error-power"></p><label class="block text-sm font-semibold">Imagen URL<input name="imagenLink" type="url" class="field-power" placeholder="https://..." /></label><p data-error="imagenLink" class="error-power"></p><label class="block text-sm font-semibold">Descripción<textarea name="descripcion" rows="4" class="field-power"></textarea></label><p data-error="descripcion" class="error-power"></p><p id="form-message" class="error-power"></p><button class="button-power w-full" type="submit">Guardar moto</button></form></div><div><div class="mb-5 flex items-center justify-between"><h2 class="text-4xl">Inventario</h2><span id="count" class="text-sm text-gray-500"></span></div><div id="admin-grid" class="grid gap-5 md:grid-cols-2"></div></div></div></section><script>
  import { api } from '../../lib/api'; import { motoSchema } from '../../schemas/moto'; import { clearSession, getSession } from '../../lib/storage'; import { motoImage } from '../../lib/images';
  const session = getSession(); if (!session?.authenticated) window.location.href = '/login'; const welcome = document.querySelector('#welcome'); if (welcome && session) welcome.textContent = `Sesión activa: ${session.usuario}`;
  const form = document.querySelector<HTMLFormElement>('#moto-form'); const grid = document.querySelector<HTMLDivElement>('#admin-grid'); const count = document.querySelector('#count'); const message = document.querySelector('#form-message'); const title = document.querySelector('#form-title'); const cancel = document.querySelector('#cancel-edit'); let motos: Awaited<ReturnType<typeof api.listMotos>>['data'] = [];
  const fields = ['modelo', 'marca', 'categoria', 'cilindrada', 'precio', 'imagenLink', 'stock', 'descripcion']; const input = (name: string) => form?.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  function resetForm() { form?.reset(); input('identificador').value = ''; input('marca').value = 'Power Motorcycle'; input('stock').value = '0'; if (title) title.textContent = 'Nueva moto'; cancel?.classList.add('hidden'); }
  function edit(id: number) { const moto = motos.find((item) => item.identificador === id); if (!moto || !form) return; fields.forEach((field) => input(field).value = String(moto[field as keyof typeof moto])); input('identificador').value = String(id); if (title) title.textContent = 'Editar moto'; cancel?.classList.remove('hidden'); window.scrollTo({ top: 0, behavior: 'smooth' }); }
  function render() { if (!grid) return; if (count) count.textContent = `${motos.length} registros`; grid.innerHTML = motos.map((moto) => `<article class="overflow-hidden rounded-2xl bg-white shadow-power"><img class="aspect-[4/3] w-full object-cover" src="${motoImage(moto.modelo, moto.imagenLink)}" alt="${moto.modelo}"><div class="p-4"><div class="flex justify-between"><h3 class="font-display text-2xl uppercase">${moto.modelo}</h3><span class="text-sm font-bold text-power-red">Bs ${moto.precio.toLocaleString('es-BO')}</span></div><p class="mt-1 text-sm text-gray-500">${moto.categoria} · Stock: ${moto.stock}</p><button data-edit="${moto.identificador}" class="mt-4 text-sm font-bold uppercase text-power-red">Editar →</button></div></article>`).join('') || '<p class="text-gray-500">No hay motos registradas.</p>'; grid.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach((button) => button.addEventListener('click', () => edit(Number(button.dataset.edit)))); }
  async function load() { try { const result = await api.listMotos(); motos = result.data; render(); } catch (error) { if (message) message.textContent = error instanceof Error ? error.message : 'No se pudo cargar el inventario'; } }
  form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!form || !message) return; message.textContent = ''; document.querySelectorAll('[data-error]').forEach((element) => element.textContent = ''); const parsed = motoSchema.safeParse(Object.fromEntries(new FormData(form))); if (!parsed.success) { parsed.error.issues.forEach((issue) => { const element = document.querySelector(`[data-error="${String(issue.path[0])}"]`); if (element && !element.textContent) element.textContent = issue.message; }); return; } try { const id = Number(input('identificador').value); if (id) await api.updateMoto(id, parsed.data); else await api.createMoto(parsed.data); resetForm(); await load(); } catch (error) { message.textContent = error instanceof Error ? error.message : 'No se pudo guardar la moto'; } });
  cancel?.addEventListener('click', resetForm); document.querySelector('#logout')?.addEventListener('click', async () => { try { await api.logout(); } finally { clearSession(); window.location.href = '/login'; } }); load();
</script></MainLayout>
