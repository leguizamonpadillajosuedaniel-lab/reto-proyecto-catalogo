---
import MainLayout from '../../layouts/MainLayout.astro';
import { modelos, modeloSlug } from '../../lib/modelos';
import { motoImage } from '../../lib/images';

export function getStaticPaths() {
  return modelos.map((modelo) => ({ params: { slug: modeloSlug(modelo) }, props: { modelo } }));
}

const { modelo } = Astro.props as { modelo: string };
const slug = modeloSlug(modelo);
---
<MainLayout title={`${modelo} | Power Motorcycle`}><section class="bg-power-charcoal py-12 text-white"><div class="container-power"><a href="/catalogo" class="text-sm font-bold uppercase text-power-orange">← Volver al catálogo</a><p class="mt-8 text-sm font-bold uppercase tracking-widest text-power-orange">Power Motorcycle</p><h1 id="model-title" class="mt-2 text-6xl">{modelo}</h1><p id="model-subtitle" class="mt-3 text-gray-300">Conocé todos los detalles de este modelo.</p></div></section><section class="py-12 md:py-16"><div class="container-power grid gap-10 lg:grid-cols-[1.1fr_.9fr]"><div class="overflow-hidden rounded-2xl bg-white shadow-power"><img id="model-image" src={motoImage(modelo)} alt={modelo} class="aspect-[4/3] w-full object-cover" /><div class="p-6"><p id="model-description" class="leading-7 text-gray-600">Cargando información del modelo...</p></div></div><div><div class="mb-6 flex items-start justify-between gap-4"><div><p id="model-category" class="text-sm font-bold uppercase tracking-widest text-power-red">Modelo Power Motorcycle</p><h2 class="mt-2 text-5xl">Tu próxima moto</h2></div><span id="model-stock" class="rounded-full bg-green-100 px-3 py-2 text-xs font-bold text-green-700">Disponible</span></div><div class="rounded-2xl bg-white p-6 shadow-power"><p class="text-sm text-gray-500">Precio de catálogo</p><p id="model-price" class="mt-1 text-4xl font-bold text-power-red">Consultando...</p><div class="mt-5 grid grid-cols-2 gap-4 border-t pt-5"><div><p class="text-xs uppercase text-gray-500">Cilindrada</p><p id="model-cc" class="mt-1 text-xl font-bold">-</p></div><div><p class="text-xs uppercase text-gray-500">Stock</p><p id="model-stock-number" class="mt-1 text-xl font-bold">-</p></div></div><a href="https://wa.me/59162123048?text=Hola%20Power%20Motorcycle%2C%20quiero%20informaci%C3%B3n%20sobre%20mi%20moto." target="_blank" rel="noopener noreferrer" class="button-power mt-7 w-full">Consultar con un asesor</a></div></div></div></section><section class="bg-power-red py-14 text-white"><div class="container-power"><p class="text-sm font-bold uppercase tracking-widest text-orange-200">Beneficios Power</p><h2 class="mt-2 text-5xl">Lo que te ofrecemos</h2><div class="mt-8 grid gap-5 md:grid-cols-3"><article class="rounded-2xl bg-white/10 p-6"><p class="font-display text-4xl">20 cuotas</p><p class="mt-2 text-sm text-red-100">Opciones de financiamiento para elegir tu moto.</p></article><article class="rounded-2xl bg-white/10 p-6"><p class="font-display text-4xl">Crédito directo</p><p class="mt-2 text-sm text-red-100">Aprobación rápida y asesoría durante el proceso.</p></article><article class="rounded-2xl bg-white/10 p-6"><p class="font-display text-4xl">1 año</p><p class="mt-2 text-sm text-red-100">Garantía o 22.000 km, lo que ocurra primero.</p></article></div></div></section><script define:vars={{ modelo }}>
  import { api } from '../../lib/api';
  import { motoImage } from '../../lib/images';
  const model = modelo;
  const title = document.querySelector('#model-title'); const subtitle = document.querySelector('#model-subtitle'); const image = document.querySelector<HTMLImageElement>('#model-image'); const description = document.querySelector('#model-description'); const category = document.querySelector('#model-category'); const price = document.querySelector('#model-price'); const cc = document.querySelector('#model-cc'); const stockNumber = document.querySelector('#model-stock-number'); const stock = document.querySelector('#model-stock');
  try { const result = await api.listMotos(`modelo=${encodeURIComponent(model)}`); const moto = result.data[0]; if (!moto) throw new Error('Modelo no encontrado'); if (title) title.textContent = moto.modelo; if (subtitle) subtitle.textContent = `${moto.marca} · ${moto.cilindrada} cc`; if (image) { image.src = motoImage(moto.modelo, moto.imagenLink); image.alt = moto.modelo; } if (description) description.textContent = moto.descripcion; if (category) category.textContent = moto.categoria; if (price) price.textContent = `Bs ${moto.precio.toLocaleString('es-BO')}`; if (cc) cc.textContent = `${moto.cilindrada} cc`; if (stockNumber) stockNumber.textContent = String(moto.stock); if (stock) { stock.textContent = moto.stock > 0 ? 'Disponible' : 'Agotada'; stock.className = `rounded-full px-3 py-2 text-xs font-bold ${moto.stock > 0 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-power-red'}`; } } catch { if (subtitle) subtitle.textContent = 'No fue posible cargar la información del modelo.'; if (description) description.textContent = 'Verifica que el backend y la base de datos estén disponibles.'; if (price) price.textContent = 'No disponible'; }
</script></MainLayout>
