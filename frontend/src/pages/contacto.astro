---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Contacto | Power Motorcycle"><section class="bg-power-charcoal py-16 text-white md:py-24"><div class="container-power"><p class="text-sm font-bold uppercase tracking-[.25em] text-power-orange">Estamos para ayudarte</p><h1 class="mt-3 text-6xl md:text-8xl">Contacto</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-gray-300">Escribinos y te respondemos por WhatsApp.</p></div></section><section class="py-16"><div class="container-power grid gap-10 lg:grid-cols-2"><div class="rounded-2xl bg-white p-7 shadow-power"><h2 class="text-4xl">Hablemos</h2><p class="mt-2 text-sm text-gray-500">Completá tus datos y se abrirá WhatsApp con tu consulta.</p><form id="contact-form" class="mt-7 space-y-4" novalidate><label class="block text-sm font-semibold">Nombre<input name="nombre" class="field-power" autocomplete="name" /></label><p data-error="nombre" class="error-power"></p><label class="block text-sm font-semibold">Teléfono<input name="telefono" class="field-power" inputmode="numeric" autocomplete="tel" placeholder="8 dígitos" /></label><p data-error="telefono" class="error-power"></p><label class="block text-sm font-semibold">Modelo de interés<select name="modelo" class="field-power"><option value="">Todavía no lo tengo decidido</option><option>BROZZ-250</option><option>FOX RS-250</option><option>NXR-250</option><option>LIBERTY-200</option><option>BIT-150</option><option>CGL-150</option><option>CGL-150E</option><option>CB1-150</option><option>BLITZ-135</option><option>BIS-135</option></select></label><label class="block text-sm font-semibold">Mensaje<textarea name="mensaje" rows="4" class="field-power" placeholder="¿En qué podemos ayudarte?"></textarea></label><p id="contact-error" class="error-power"></p><button class="button-power w-full" type="submit">Hablar con un asesor</button><p class="text-xs text-gray-500">No guardamos tus datos en el sitio.</p></form></div><div class="space-y-6"><article class="rounded-2xl bg-power-mist p-7"><h2 class="text-3xl">Showroom</h2><p class="mt-3 leading-7 text-gray-600">Av. Cristo Redentor, 7mo anillo, Santa Cruz de la Sierra</p><a class="mt-3 inline-block font-bold text-power-red" href="tel:+59175347939">75347939</a></article><article class="rounded-2xl bg-power-mist p-7"><h2 class="text-3xl">Servicio técnico</h2><p class="mt-3 leading-7 text-gray-600">Av. 30 de Octubre (Av. La Campana), entre 7mo y 8vo anillo, N.º 7845</p></article><article class="rounded-2xl bg-power-mist p-7"><h2 class="text-3xl">Horarios</h2><p class="mt-3 text-gray-600">Lunes a viernes: 08:30–12:00 y 13:30–18:00.</p><p class="text-gray-600">Sábado: 08:30–12:30.</p><div class="mt-4 flex gap-4 font-bold"><a href="https://www.instagram.com/powermotorcycle_/" target="_blank" rel="noopener">Instagram</a><a href="https://www.facebook.com/MotosPowerBolivia/" target="_blank" rel="noopener">Facebook</a></div></article></div></div></section><script>
  import { contactSchema } from '../schemas/contact';
  const form = document.querySelector<HTMLFormElement>('#contact-form'); const general = document.querySelector('#contact-error');
  form?.addEventListener('submit', (event) => { event.preventDefault(); if (!form) return; document.querySelectorAll('[data-error]').forEach((element) => element.textContent = ''); if (general) general.textContent = ''; const result = contactSchema.safeParse(Object.fromEntries(new FormData(form))); if (!result.success) { result.error.issues.forEach((issue) => { const element = document.querySelector(`[data-error="${String(issue.path[0])}"]`); if (element && !element.textContent) element.textContent = issue.message; }); return; } const message = [`Hola Power Motorcycle, soy ${result.data.nombre}.`, `Mi teléfono es ${result.data.telefono}.`, result.data.modelo ? `Me interesa la ${result.data.modelo}.` : '', result.data.mensaje ? `Consulta: ${result.data.mensaje}` : ''].filter(Boolean).join(' '); window.open(`https://wa.me/59162123048?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer'); });
</script></MainLayout>
