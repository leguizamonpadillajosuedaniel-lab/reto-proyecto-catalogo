---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Acceso administrador | Power Motorcycle"><section class="grid min-h-[calc(100vh-13rem)] place-items-center bg-power-charcoal px-4 py-16"><div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-power md:p-10"><div class="mb-8"><p class="text-sm font-bold uppercase tracking-widest text-power-red">Área privada</p><h1 class="mt-2 text-5xl">Iniciar sesión</h1><p class="mt-3 text-sm text-gray-500">Accedé para administrar el catálogo de motos.</p></div><form id="login-form" novalidate><label class="block text-sm font-semibold">Usuario<input name="usuario" autocomplete="username" class="field-power" /></label><p data-error="usuario" class="error-power"></p><label class="mt-5 block text-sm font-semibold">Contraseña<input name="contrasena" type="password" autocomplete="current-password" class="field-power" /></label><p data-error="contrasena" class="error-power"></p><p id="login-error" class="error-power mt-4"></p><button class="button-power mt-6 w-full" type="submit">Ingresar</button></form></div></section><script>
  import { api } from '../lib/api'; import { loginSchema } from '../schemas/auth'; import { saveSession } from '../lib/storage';
  const form = document.querySelector<HTMLFormElement>('#login-form'); const general = document.querySelector<HTMLParagraphElement>('#login-error');
  form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!form || !general) return; general.textContent = ''; document.querySelectorAll('[data-error]').forEach((element) => element.textContent = ''); const result = loginSchema.safeParse(Object.fromEntries(new FormData(form))); if (!result.success) { result.error.issues.forEach((issue) => { const element = document.querySelector(`[data-error="${String(issue.path[0])}"]`); if (element && !element.textContent) element.textContent = issue.message; }); return; } const button = form.querySelector('button'); if (button) button.disabled = true; try { const response = await api.login(result.data.usuario, result.data.contrasena); saveSession(response.usuario); window.location.href = '/admin'; } catch (error) { general.textContent = error instanceof Error ? error.message : 'No fue posible iniciar sesión'; if (button) button.disabled = false; } });
</script></MainLayout>
