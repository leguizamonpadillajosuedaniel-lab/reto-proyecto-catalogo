---
import MainLayout from '../layouts/MainLayout.astro';
const servicios = ['Cambio de aceite de motor', 'Limpieza de filtro de aceite', 'Limpieza de filtro de aire', 'Regulado de válvulas', 'Revisión de chicotillos', 'Ajuste de ralentí', 'Revisión de presión de llantas', 'Lubricación de chicotillos y cadenas', 'Revisión de balatas y pastillas de freno', 'Verificación de luces', 'Revisión del pedal de cambio', 'Lubricación del parador'];
---
<MainLayout title="Post venta | Power Motorcycle"><section class="bg-power-charcoal py-16 text-white md:py-24"><div class="container-power"><p class="text-sm font-bold uppercase tracking-[.25em] text-power-orange">Servicio técnico autorizado</p><h1 class="mt-3 text-6xl md:text-8xl">Power Service</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-gray-300">Cuidamos tu moto. Vos disfrutás el camino.</p></div></section><section class="py-16"><div class="container-power grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><p class="text-sm font-bold uppercase tracking-widest text-power-red">Mantenimiento</p><h2 class="mt-2 text-5xl">Todo listo para seguir andando</h2><p class="mt-5 leading-7 text-gray-600">En nuestro servicio técnico autorizado realizamos el mantenimiento que tu moto necesita y contamos con venta de repuestos.</p><a class="button-power mt-7" href="https://wa.me/59162123048?text=Hola%20Power%20Motorcycle%2C%20quiero%20agendar%20un%20mantenimiento." target="_blank" rel="noopener noreferrer">Agendar una cita</a></div><div class="rounded-2xl bg-white p-7 shadow-power"><h2 class="text-3xl">Qué incluye el mantenimiento</h2><ul class="mt-6 grid gap-3 sm:grid-cols-2">{servicios.map((servicio) => <li class="flex gap-3 text-sm text-gray-700"><span class="font-bold text-power-red">✓</span>{servicio}</li>)}</ul></div></div></section><section class="bg-power-mist py-14"><div class="container-power"><h2 class="text-4xl">Dónde te atendemos</h2><div class="mt-6 grid gap-5 md:grid-cols-2"><article class="rounded-xl bg-white p-5 shadow"><p class="font-bold text-power-red">La Campana</p><h3 class="mt-1 text-2xl">Servicio técnico y repuestos</h3><p class="mt-2 text-sm text-gray-600">Av. 30 de Octubre (Av. La Campana), entre 7mo y 8vo anillo, N.º 7845.</p><a class="mt-3 inline-block font-bold" href="tel:+59177014299">Fernando · 77014299</a></article><article class="rounded-xl bg-white p-5 shadow"><p class="font-bold text-power-red">7mo anillo</p><h3 class="mt-1 text-2xl">Servicio técnico</h3><p class="mt-2 text-sm text-gray-600">Atención técnica con Cristina.</p><a class="mt-3 inline-block font-bold" href="tel:+59175559445">75559445</a></article></div><p class="mt-6 text-sm text-gray-600">Lunes a viernes de 08:30 a 12:00 y de 13:30 a 18:00. Sábado de 08:30 a 12:30.</p></div></section></MainLayout>
